# Copy this file to .env (next to main.py) and fill in your values. Never submit .env.
# LangSmith, optional (the local tracer and the local experiment need no key):
#   smith.langchain.com -> Settings -> API Keys -> Create API Key.
LANGSMITH_API_KEY=
# Langflow API key, needed by `python main.py flow-ask`:
#   Langflow -> your profile icon -> Settings -> Langflow API Keys -> Add New.
LANGFLOW_API_KEY=
