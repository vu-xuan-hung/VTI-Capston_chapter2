# Copy this file to .env.langflow and start Langflow with:  langflow run --env-file .env.langflow
# Settings for ONE person on a laptop - not for a shared server.
LANGFLOW_HOST=127.0.0.1
LANGFLOW_PORT=7860
LANGFLOW_AUTO_LOGIN=true
LANGFLOW_DO_NOT_TRACK=true
# Langflow blocks model addresses on this computer (127.0.0.1) unless you allow them - our model server is one:
LANGFLOW_SSRF_ALLOWED_HOSTS=127.0.0.1,localhost
# Langflow 1.12.6 refuses to build the "Chroma DB" component (even in server mode, with an empty Persist Directory)
# while it restricts local file access ("Local-file access requires an authenticated user or flow scope").
# Safe on your own laptop; keep it true on a shared server.
LANGFLOW_RESTRICT_LOCAL_FILE_ACCESS=false

# OPTIONAL - send the traces of every flow run to LangSmith. Needs your own LangSmith key.
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=factdesk-langflow
